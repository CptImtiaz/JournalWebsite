# PostgreSQL (Neon / Vercel Postgres / any Postgres). Neon integration sets these automatically.
DATABASE_URL="postgresql://user:password@host:5432/journal?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/journal?sslmode=require"

# Public site URL (used in emails, sitemap, DOI metadata). Defaults to the Vercel production URL.
APP_URL="https://your-journal-domain.org"

# First Super Administrator (created on first deploy only)
ADMIN_EMAIL="admin@your-journal-domain.org"
ADMIN_PASSWORD="choose-a-long-password"

# Private file storage (Vercel Blob, private store). Without it files go to ./.uploads (local dev only).
BLOB_READ_WRITE_TOKEN=""

# SMTP (without it, emails are recorded in the delivery log but not sent)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="editorial@your-journal-domain.org"

# Crossref deposit credentials (after Crossref membership)
CROSSREF_USERNAME=""
CROSSREF_PASSWORD=""

# Protects the daily reminder job (/api/cron/reminders). Vercel Cron sends it automatically.
CRON_SECRET=""

# Optional external malware scanner endpoint that returns 2xx for clean files
MALWARE_SCAN_URL=""
